#!/usr/bin/env ruby
_gemfile = ENV["BUNDLE_GEMFILE"] || File.expand_path("../Gemfile", __dir__)
_root = File.expand_path("..", _gemfile)
APP_PATH = File.join(_root, "config", "application")
$LOAD_PATH.unshift File.join(_root, "lib")
require File.join(_root, "config", "boot")
require "rails/commands"
